            </ENTRY>
            <ENTRY COLUMN="0" ROW="2">
              <FIGURE SUBTYPE="PapActivity" FORMAT="1.00" ID="4">
                <TEXT><![CDATA[static uint32_t t_ctrl = 0;static uint32_t t_1s = 0; uint32_t nowMS = millis();]]></TEXT>
              </FIGURE>
            </ENTRY>
            <ENTRY COLUMN="0" ROW="3">
              <FIGURE SUBTYPE="PapCondition" FORMAT="1.00" ID="6">
                <TEXT><![CDATA[nowMS - t_ctrl >= loop_time]]></TEXT>
              </FIGURE>
            </ENTRY>
